  "rewrites": [
    {
      "source": "/",
      "destination": "/ekin-home"
    },
    {
      "source": "/us",
      "destination": "/ekin-home"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Vary",
          "value": "x-vercel-ip-country"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(assets|images)/(.*)\\.(webp|jpg|jpeg|png|avif|svg|mp4)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=31536000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=31536000, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "functions": {
    "api/forms/submit.js": {
      "maxDuration": 15
    },
    "api/forms/retry.js": {
      "maxDuration": 60
    },
    "api/forms/review.js": {
      "maxDuration": 15
    },
    "api/careers/upload.js": {
      "maxDuration": 15
    },
    "api/careers/apply.js": {
      "maxDuration": 45
    },
    "api/careers/parse.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/forms/retry",
      "schedule": "0 6 * * *"
    }
  ]
}
