# Ekin Mint web intake — set these in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Required. Generated in Mint → Settings → Web İletişim Alımı. Server-side only.
MINT_API_KEY=

# Optional. Defaults to the live endpoint.
# MINT_API_URL=https://mint.ekin.com/api/method/ekin_mint.api.web_intake.submit

# Required for the retry queue. Added automatically when you connect an
# Upstash Redis store (Vercel → Storage / Marketplace) to this project.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Required for /api/forms/retry. Vercel sends it on cron calls as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Recommended. Token for the internal review page /api/forms/review (falls back to CRON_SECRET).
REVIEW_TOKEN=

# Optional hardening.
# ALLOWED_ORIGINS=https://www.ekin.com,https://ekin.com
# SOURCE_SITE=www.ekin.com

# ---- Job applications (/api/careers/*) ----
# Added automatically when you connect a Vercel Blob store to this project (Storage → Blob).
BLOB_READ_WRITE_TOKEN=

# Resend (resend.com) API key; the sender domain (ekin.com) must be verified in Resend.
RESEND_API_KEY=

# Where applications are e-mailed (comma-separated for several) and the sender shown.
CAREERS_TO=jobs@ekin.com
CAREERS_FROM=Ekin Careers <careers@ekin.com>

# CV auto-fill (/api/careers/parse): Anthropic API key; optional model override.
ANTHROPIC_API_KEY=
CV_PARSE_MODEL=claude-sonnet-4-5

# Job applications → Ekin Bloom (career.ekin.com)
EKIN_BLOOM_API_KEY=
# EKIN_BLOOM_URL=https://career.ekin.com/api/method/ekin_erp.api.career.submit_application
# CAREERS_EMAIL_COPY=1   # also e-mail every application to CAREERS_TO
